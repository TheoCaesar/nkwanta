# Copy this file to .env and fill it in. .env is gitignored and must never be committed.

# --- Database ----------------------------------------------------------------
# Paste the connection string from the Neon dashboard exactly as given. The
# application normalises it for the asyncpg driver automatically — it strips
# 'sslmode', adds 'ssl=require' and inserts the '+asyncpg' driver name for you.
# Use the POOLED connection string.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/nkwanta?sslmode=require

# --- Application -------------------------------------------------------------
ENVIRONMENT=development

# --- Clustering ---------------------------------------------------------------
# The two most important numbers in the system: how close in space and in time two
# reports must be to be treated as the same real-world event.
CLUSTER_RADIUS_METRES=300
CLUSTER_WINDOW_MINUTES=30

# How long before a report contributes half as much to an incident's confidence.
CONFIDENCE_HALF_LIFE_MINUTES=45
